// Power BI measures for the verified Olist aggregate tables.
// Rename imported tables to: Monthly, Regions, Reviews, Categories, KPIs.
// Measures are defined separately by reporting grain to avoid double counting.

// EXECUTIVE: all-time period unless a Monthly filter is explicitly applied
Orders = SUM('Monthly'[orders])
Delivered Orders = SUM('Monthly'[delivered])
Eligible Deliveries = SUM('Monthly'[on_time_eligible])
On-time Deliveries = SUM('Monthly'[on_time_deliveries])
Late Deliveries = SUM('Monthly'[late_deliveries])
On-time Delivery Rate = DIVIDE([On-time Deliveries], [Eligible Deliveries])
Late Delivery Rate = DIVIDE([Late Deliveries], [Eligible Deliveries])

// Overall historical lead time is a fixed period-wide KPI.
// This KPI is NOT segmented by month or customer region in the published aggregates.
Avg Lead Days - Historical = MAX('KPIs'[avg_delivery_lead_days])
Canceled Orders - Historical = MAX('KPIs'[cancelled_orders])

// CUSTOMER DESTINATION: Regions table, one row per destination state
Region Eligible Deliveries = SUM('Regions'[eligible_deliveries])
Region Late Deliveries = SUM('Regions'[late_deliveries])
Region On-time Rate = DIVIDE(SUM('Regions'[on_time_deliveries]), [Region Eligible Deliveries])

// CUSTOMER REVIEWS: each row represents a delivery outcome, already summarized
// For a two-bar review chart use Reviews[delivery_outcome] as category
// and Reviews[avg_review_score] directly as the numeric value.
// Do NOT sum precomputed average scores.

// FREIGHT / PRODUCT CATEGORIES: category-level item and listed freight values
Listed Item Value BRL = SUM('Categories'[item_value_brl])
Listed Freight BRL = SUM('Categories'[freight_brl])
Freight to Item Value Rate = DIVIDE([Listed Freight BRL], [Listed Item Value BRL])

// Formatting in Power BI model:
// On-time Delivery Rate, Late Delivery Rate, Region On-time Rate,
// Freight to Item Value Rate: percentage with two decimal places.
// Monetary measures: BRL.
// Average lead days: decimal with two places.
// Do NOT relate Monthly, Regions, Reviews or Categories directly:
// they are independently aggregated at different reporting grains.
